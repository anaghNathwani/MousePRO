{
  "name": "mousepro",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron-dev": "concurrently --kill-others-on-fail --names \"next,electron\" --prefix-colors \"cyan,magenta\" \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-build": "next build && electron-builder --mac",
    "electron-build-all": "next build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.anaghnathwani.mousepro",
    "productName": "MousePRO",
    "copyright": "Copyright © 2025 anaghNathwani",
    "asar": true,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json",
      "next.config.js"
    ],
    "extraResources": [
      {
        "from": "helper/MousePROHelper",
        "to": "MousePROHelper",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "MousePRO",
      "background": null,
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 540, "height": 380 }
    }
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "framer-motion": "^11.1.7",
    "react-dropzone": "^14.2.3",
    "sharp": "^0.33.3",
    "jszip": "^3.10.1",
    "zustand": "^4.5.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0",
    "lucide-react": "^0.378.0",
    "react-colorful": "^5.6.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
